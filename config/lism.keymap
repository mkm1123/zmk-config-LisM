#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q        &kp W       &kp E           &kp R           &kp T                                      &kp Y           &kp U           &kp I            &kp O         &kp P
&kp A        &kp S       &kp D           &kp F           &kp G                                      &kp H           &kp J           &kp K            &kp L         &kp SEMICOLON
&kp Z        &kp X       &kp C           &kp V           &kp B                                      &kp N           &kp M           &kp COMMA        &kp DOT       &kp SLASH
&lt 4 LCTRL  &lt 3 LGUI  &lt 0 LALT      &msc SCRL_UP    &lt 2 SPACE      &lt 1 BACKSPACE    &mo 1  &mo 2           &msc SCRL_UP    &to 0            &lt 3 DELETE  &lt 4 ENTER
                         &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
&kp ESC    &trans    &trans          &mkp MCLK        &trans                            &trans          &mkp MCLK       &kp LG(LEFT)     &kp LG(RIGHT)  &trans
&kp TAB    &trans    &mkp LCLK       &mkp RCLK        &msc SCRL_UP                      &msc SCRL_UP    &mkp LCLK       &mkp RCLK        &trans         &trans
&kp LSHFT  &trans    &msc SCRL_LEFT  &msc SCRL_RIGHT  &msc SCRL_DOWN                    &msc SCRL_DOWN  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans         &trans
&kp LCTRL  &kp LGUI  &kp LALT        &trans           &trans          &trans    &trans  &trans          &trans          &to 0            &to 3          &to 4
                     &trans          &trans           &trans                            &trans          &trans          &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
&trans  &trans  &trans    &trans    &trans                                           &trans    &trans    &kp N7     &kp N8    &kp N9
&trans  &trans  &trans    &trans    &trans                                           &trans    &trans    &kp N4     &kp N5    &kp N6
&trans  &trans  &trans    &trans    &trans                                           &trans    &trans    &kp N1     &kp N2    &kp N3
&trans  &trans  &trans    &kp UP    &kp INT_MUHENKAN  &kp INTERNATIONAL_4    &trans  &trans    &kp UP    &to 0      &lt 3 N0  &to 4
                &kp LEFT  &kp DOWN  &kp RIGHT                                        &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
&trans  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
&trans  &trans  &trans  &trans  &trans                    &kp PIPE   &kp COLON  &kp MINUS  &kp CARET  &kp BACKSLASH
&trans  &trans  &trans  &trans  &trans                    &kp UNDER  &kp SEMI   &kp LBKT   &kp RBKT   &kp GRAVE
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans     &to 0      &lt 3 F11  &lt 4 F12
                &trans  &trans  &trans                    &trans     &trans     &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&none        &none           &none   &none   &bt BT_CLR                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none        &none           &none   &none   &none                                &none         &none         &none         &none         &none
&sys_reset   &none           &none   &none   &none                                &none         &none         &none         &none         &sys_reset
&bootloader  &bt BT_CLR_ALL  &none   &none   &none       &none    &studio_unlock  &none         &none         &none         &none         &bootloader
                             &trans  &trans  &trans                               &trans        &trans        &trans
            >;
        };

        layer_5 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };
    };
};
